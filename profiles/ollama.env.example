# Opt-in native Ollama profile. No paid key; does not modify other environments.
# MAZMI_ENV_FILE=/absolute/path/to/profiles/ollama.env.example
# DATABASE_URL must be set privately to a dedicated local database.
APP_ENV=development
DEMO_MODE=false
GENERATION_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen3:4b
OLLAMA_EMBEDDING_MODEL=embeddinggemma
OLLAMA_NUM_CTX=4096
OLLAMA_TIMEOUT_SECONDS=120
EMBEDDING_DIMENSIONS=768
# One model-backed chat turn at a time on small machines (8 GB). Exact ticket reads
# never wait for this queue.
CHAT_MAX_CONCURRENT=1
# Qwen3 reasoning control. model_default is the measured, safer default.
# no_think_directive cut the 8-case run from 777 s to 176 s here but accepted
# insufficient evidence in 2/4 negative cases (backend/evals/v2-local-no-think.json).
OLLAMA_REASONING=model_default
