# MAZMI Ops Copilot — configuración local. Copia este archivo a .env (nunca se sube a Git).
# La IA se ejecuta en tu equipo con Ollama: no hay claves ni servicios de pago.

APP_ENV=production

# --- PostgreSQL (pgvector) ---
POSTGRES_DB=mazmi_ops
POSTGRES_USER=mazmi
# Cambia esta contraseña antes de exponer la base fuera de tu equipo.
POSTGRES_PASSWORD=mazmi_local_change_me
# DATABASE_URL lo usa Python en local; Docker Compose deriva la suya de POSTGRES_*.
DATABASE_URL=postgresql://mazmi:mazmi_local_change_me@localhost:55432/mazmi_ops

# --- Ollama (generación y embeddings) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen3:4b
OLLAMA_EMBEDDING_MODEL=embeddinggemma
OLLAMA_NUM_CTX=4096
OLLAMA_TIMEOUT_SECONDS=120
# Tiempo que Ollama mantiene el modelo en memoria tras una petición (0 = descargar al instante).
OLLAMA_KEEP_ALIVE=5m
# off: sin fase de razonamiento (medido: sin timeouts, 4x más rápido). on: razonamiento de Qwen3.
OLLAMA_REASONING=off
# Carga los dos modelos en memoria al arrancar el backend: la primera pregunta no paga el
# arranque en frío (15-30 s en un Mac de 8 GB). Desactívalo si prefieres memoria libre.
OLLAMA_WARMUP=true
# Dimensiones de EmbeddingGemma (768 por defecto). Cambiarlas exige reindexar.
# EMBEDDING_DIMENSIONS=768

# --- Respuestas con evidencia ---
# quoted_v6: el modelo copia citas literales y el servidor las verifica (recomendado).
# passage_ids_v5: selección de pasajes de MAZMI 2.0, solo para comparar.
EVIDENCE_MODE=quoted_v6
# Línea «Respuesta: …» sobre la evidencia, solo si el dato aparece literal en la cita mostrada.
ANSWER_LEAD=true
RETRIEVAL_MIN_SCORE=0.25
# Con un único modelo local, una consulta de IA a la vez (8 GB de RAM).
CHAT_MAX_CONCURRENT=1
# CHAT_QUEUE_TIMEOUT_SECONDS=20
# CHAT_STREAM_TIMEOUT_SECONDS=330

# --- Servidor ---
BACKEND_URL=http://127.0.0.1:8000
# true cuando se sirve por HTTPS; en HTTP local debe ser false.
COOKIE_SECURE=false
DB_PORT=55432
API_PORT=8000
WEB_PORT=3000

# --- Voz opcional (modelos locales ya descargados; ver LOCAL_AI.md) ---
STT_MODEL_PATH=
PIPER_MODEL_PATH=
PIPER_EXECUTABLE=piper
