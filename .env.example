POSTGRES_DB=mazmi_ops
POSTGRES_USER=mazmi
POSTGRES_PASSWORD=mazmi_local_change_me
DATABASE_URL=postgresql://mazmi:mazmi_local_change_me@localhost:55432/mazmi_ops
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin
BACKEND_URL=http://127.0.0.1:8000
RETRIEVAL_MIN_SCORE=0.25
# DATABASE_URL is for local Python; Compose derives its internal URL from POSTGRES_*
# Changing embedding provider/model/dimensions requires explicit reindexing; migration 004 isolates collections.
# Set true when served over HTTPS. Local HTTP needs false.
COOKIE_SECURE=false
DB_PORT=55432
API_PORT=8000
WEB_PORT=3000

# Cloud test default. Use a Google project WITHOUT billing; no automatic fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GENERATION_PROVIDER=gemini
EMBEDDING_PROVIDER=gemini
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen3:4b
OLLAMA_EMBEDDING_MODEL=embeddinggemma
# Leave unset for provider defaults: Gemini/Ollama 768, OpenAI 1536.
# EMBEDDING_DIMENSIONS=768
# Change revision when deliberately changing a cloud embedding deployment.
EMBEDDING_REVISION=legacy
TTS_PROVIDER=piper
PIPER_MODEL_PATH=
PIPER_EXECUTABLE=piper
STT_MODEL_PATH=

# Development demo is OFF. Requires APP_ENV=development and a dedicated *_demo database.
APP_ENV=production
DEMO_MODE=false
